{
  "name": "@zonos/amino",
  "version": "6.2.1",
  "description": "Core UI components for Amino",
  "repository": "git@github.com:Zonos/amino.git",
  "license": "MIT",
  "private": false,
  "homepage": "https://amino.zonos.com",
  "engines": {
    "node": "^22"
  },
  "packageManager": "pnpm@10.33.0",
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "scripts": {
    "build:ci": "pnpm build:theme && pnpm build:ts && pnpm build:dts",
    "build:dts": "tsc -p ./tsconfig.emitDeclarationOnly.json && tsc-alias -p ./tsconfig.emitDeclarationOnly.json",
    "build:prep:publish": "tsx build-utils/setupPackage.ts",
    "build:theme": "tsx build-utils/css/buildTheme.ts",
    "build:ts": "tsx build-utils/build.ts",
    "build": "pnpm install && pnpm ci:concurrent && pnpm build:theme && pnpm build:ts && pnpm build:dts",
    "ci:concurrent": "concurrently 'pnpm tsc' 'pnpm lint:prod' 'pnpm test:prod' --group --raw --success='all'",
    "ci": "pnpm tsc && pnpm lint:prod && pnpm test:prod",
    "dev:open": "concurrently 'pnpm dev' 'pnpm open'",
    "dev": "concurrently 'caddy run --config  $HOME/caddy/Caddyfile' 'pnpm storybook:dev'",
    "format:check": "prettier --check \"**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}\"",
    "lint:fix": "oxlint --fix && prettier --write \"**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}\"",
    "lint:prod": "oxlint -c .oxlintrc.prod.json && pnpm format:check",
    "lint": "oxlint",
    "lint:copy": "oxlint --fix 2>&1 | tee /dev/tty | pbcopy",
    "open": "open https://dev.amino.zonos.com",
    "postbuild:ci": "pnpm postbuild",
    "postbuild:dts": "echo 'done build dts'",
    "postbuild:prep:publish": "echo 'done building for publishing'",
    "postbuild:theme": "echo 'done generating styles'",
    "postbuild": "cp -r ./src/styles/*.css ./dist && cp -r ./src/styles/*.scss ./dist && rm -f ./dist/tailwind.css && pnpm build:prep:publish",
    "prebuild:ci": "pnpm prebuild",
    "prebuild:dts": "echo 'building dts'",
    "prebuild:prep:publish": "echo 'building for publishing'",
    "prebuild:theme": "echo 'start generating styles'",
    "prebuild": "echo 'start cleaning up' && rm -rf dist && echo 'done cleaning up'",
    "push:tags": "git push origin $(git rev-parse --abbrev-ref HEAD) --follow-tags",
    "serve": "pnpm dlx http-server ./storybook-static",
    "start": "pnpm storybook build && pnpm storybook:dev",
    "storybook:build": "storybook build",
    "storybook:dev": "storybook dev -p 6006 --no-open",
    "svgs:react:flags": "tsx ./svgReact/flags",
    "svgs:react:icons": "tsx ./svgReact/icons",
    "template:logic-constant": "tsx build-utils/css/generateLogicConstTemplate.ts",
    "test:prod": "vitest run",
    "test:pw": "playwright test",
    "test:pw:local": "playwright test -c playwright.local.config.ts",
    "test:visual:baseline": "PLAYWRIGHT_TEST_BASE_URL=https://amino.zonos.com playwright test visual-regression --update-snapshots --project=chromium",
    "test:visual": "playwright test visual-regression --project=chromium",
    "test:visual:review": "pnpm test:visual; pnpm test:analyze",
    "test:css-compare": "playwright test css-comparison --project=chromium --config playwright.css-compare.config.ts",
    "test:analyze": "tsx scripts/analyze-visual-diffs.ts",
    "test:analyze:triage": "tsx scripts/analyze-visual-diffs.ts --triage",
    "test:sb": "test-storybook",
    "test:all": "pnpm test:prod && pnpm test:pw && pnpm test:sb",
    "test": "vitest --run",
    "test:copy": "vitest run 2>&1 | tee /dev/tty | pbcopy",
    "translate": "cd ../zonos.com && pnpm gen:translate:inline:amino",
    "tsc": "tsc --noEmit",
    "tsc:copy": "tsc --noEmit 2>&1 | tee /dev/tty | pbcopy",
    "version:major": "pnpm build && pnpm version major -m 'Bump version %s' && pnpm push:tags",
    "version:minor": "pnpm build && pnpm version minor -m 'Bump version %s' && pnpm push:tags",
    "version:patch": "pnpm build && pnpm version patch -m 'Bump version %s' && pnpm push:tags",
    "version:prealpha": "pnpm build && pnpm version prerelease --preid alpha -m 'Bump version %s' && pnpm push:tags",
    "version:premajor:alpha": "pnpm build && pnpm version premajor --preid alpha -m 'Bump version %s' && pnpm push:tags"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@rollup/plugin-json": "^6.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fuse.js": "^7.5.0",
    "react-dropzone": "^12.1.0",
    "react-intersection-observer": "^11.0.1",
    "react-select": "^5.10.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.7",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@chromatic-com/storybook": "^5.5.1",
    "@playwright/test": "1.58.2",
    "@rollup/plugin-alias": "^5.1.1",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-image": "^3.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-designs": "^11.1.4",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-links": "^10.6.2",
    "@storybook/addon-onboarding": "^10.6.2",
    "@storybook/addon-styling-webpack": "^3.0.2",
    "@storybook/addon-webpack5-compiler-swc": "^4.0.3",
    "@storybook/react-webpack5": "^10.6.2",
    "@storybook/test-runner": "^0.26.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/react": "^16.3.2",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/lodash": "^4.17.24",
    "@types/node": "^22.19.11",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.4.14",
    "concurrently": "^10.0.6",
    "css-loader": "^7.1.5",
    "dayjs": "^1.11.19",
    "dotenv": "^18.0.8",
    "eslint-plugin-no-relative-import-paths": "1.5.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-sort-destructure-keys": "3.0.0",
    "eslint-plugin-storybook": "^10.6.2",
    "eslint-plugin-typescript-sort-keys": "^3.3.0",
    "framer-motion": "^14.3.0",
    "glob": "^13.0.6",
    "jsdom": "^30.1.3",
    "lodash": "^4.18.1",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "postcss": "^8.5.30",
    "postcss-loader": "^8.2.0",
    "postcss-preset-env": "11.6.1",
    "prettier": "^3.8.1",
    "prettier-plugin-classnames": "^0.10.4",
    "prettier-plugin-merge": "^0.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rollup": "^4.64.7",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-progress": "^1.1.2",
    "rollup-plugin-sizes": "^1.1.0",
    "storybook": "^10.6.2",
    "storybook-addon-tag-badges": "^3.1.0",
    "style-loader": "^4.0.0",
    "svgo": "^4.1.0",
    "swr": "^2.4.0",
    "tailwindcss": "^4.1.18",
    "tailwindcss-animate": "^1.0.7",
    "ts-toolbelt": "^9.6.0",
    "tsc-alias": "~1.8.17",
    "tslib": "^2.8.1",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "overrides": {
      "uuid@<11.1.1": "^11.1.1",
      "postcss-selector-parser@<7.1.6": "^7.1.6",
      "@istanbuljs/load-nyc-config>js-yaml": "^4.3.2",
      "@storybook/builder-webpack5>webpack-dev-middleware": "^7.4.6",
      "@storybook/test-runner>playwright": "1.58.2",
      "@storybook/test-runner>playwright-core": "1.58.2"
    }
  },
  "peerDependencies": {
    "dayjs": "*",
    "framer-motion": "^12.x || ^13.x || ^14.x",
    "lodash": "^4.17.23",
    "react": "^19.x",
    "react-dom": "^19.x",
    "swr": "2.x",
    "zustand": "^5.0.0"
  }
}
